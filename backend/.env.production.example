# ========================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO
# ========================================
# ⚠️ Use este arquivo apenas como template.
# ⚠️ Nunca commite secrets reais no Git.

# === SERVIDOR ===
NODE_ENV=production
PORT=3000

# === DATABASE ===
# Use MongoDB Atlas com usuário/senha fortes e IP whitelist restrito.
MONGO_URI=mongodb+srv://SEU_USER:SUA_SENHA@cluster.mongodb.net/guia_aventureiro_db?retryWrites=true&w=majority

# === JWT ===
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UMA_STRING_ALEATORIA_LONGA_64B
JWT_REFRESH_SECRET=GERE_OUTRA_STRING_ALEATORIA_LONGA_64B

# === CLOUDINARY ===
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# === GROQ ===
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# === STRIPE (LIVE) ===
# Dashboard live: https://dashboard.stripe.com/apikeys
# Use SOMENTE chaves live em produção.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Price ID LIVE do plano Premium (não usar price de test mode)
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx

# Base pública HTTPS para redirect do checkout
# Exemplo: https://api.seudominio.com
STRIPE_REDIRECT_BASE_URL=https://api.seudominio.com

# URL de retorno do Customer Portal
# Pode ser deep link do app ou URL web HTTPS
STRIPE_PORTAL_RETURN_URL=guiaaventureiro://profile

# === CORS ===
# Lista CSV de origens permitidas (HTTPS)
# Exemplo: https://app.seudominio.com,https://www.seudominio.com
FRONTEND_URL=https://app.seudominio.com

# === LOGGING ===
ENABLE_FILE_LOGGING=true

# ========================================
# CHECKLIST RÁPIDO DE GO-LIVE (STRIPE)
# ========================================
# [ ] STRIPE_SECRET_KEY começa com sk_live_
# [ ] STRIPE_PUBLISHABLE_KEY começa com pk_live_
# [ ] STRIPE_WEBHOOK_SECRET configurado para endpoint live
# [ ] STRIPE_PREMIUM_PRICE_ID criado no modo LIVE
# [ ] STRIPE_REDIRECT_BASE_URL usa HTTPS público (sem localhost)
# [ ] Webhook no Stripe aponta para: /api/subscriptions/webhook
# [ ] Eventos habilitados: checkout.session.completed,
#     customer.subscription.created/updated/deleted,
#     invoice.payment_succeeded, invoice.payment_failed
# [ ] FRONTEND_URL com domínios finais de produção
# ========================================
