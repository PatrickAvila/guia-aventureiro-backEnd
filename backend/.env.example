# ========================================
# VARIÁVEIS DE AMBIENTE - GUIA AVENTUREIRO
# ========================================
# ⚠️ ATENÇÃO: NUNCA commite o arquivo .env no Git!
# Este é apenas um template. Copie para .env e preencha com valores reais.

# === SERVIDOR ===
NODE_ENV=development
PORT=3000

# === DATABASE ===
# Formato: mongodb+srv://usuario:senha@cluster.mongodb.net/nome_do_banco
MONGO_URI=mongodb+srv://SEU_USER:SUA_SENHA@cluster.mongodb.net/guia_aventureiro_db?retryWrites=true&w=majority

# === JWT (JSON Web Tokens) ===
# ⚠️ IMPORTANTE: Use secrets fortes e únicos em produção!
# Gerar secrets seguros: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GERE_UMA_STRING_ALEATORIA_LONGA_AQUI
JWT_REFRESH_SECRET=GERE_OUTRA_STRING_ALEATORIA_DIFERENTE_AQUI

# === CLOUDINARY (Upload de Imagens) ===
# Obter em: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# === GROQ (IA - Geração de Roteiros) ===
# Obter em: https://console.groq.com/keys
# Grátis: 14,400 requests/dia
GROQ_API_KEY=gsk_xxxxxxxxxxxxx

# === STRIPE (Pagamentos) ===
# Obter em: https://dashboard.stripe.com/test/apikeys
# Test Mode (desenvolvimento)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
# Price ID do plano Premium (criar produto no Stripe Dashboard)
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxx
# Production Mode (depois do teste)
# STRIPE_SECRET_KEY_LIVE=sk_live_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_xxxxxxxxxxxxx

# === DEEP LINKS (Mobile App) ===
# Scheme para deep links (deve coincidir com app.json do mobile)
APP_SCHEME=guiaaventureiro

# === CORS (Cross-Origin Resource Sharing) ===
# Em produção, especificar domínios exatos (separar múltiplos com vírgula)
# Exemplo: https://seudominio.com,https://www.seudominio.com
FRONTEND_URL=http://localhost:8081
# Base HTTPS para redirecionamento do Stripe Checkout
# Em desenvolvimento no Expo Go, prefira uma URL pública estável
STRIPE_REDIRECT_BASE_URL=https://example.com
# URL de retorno do Stripe Customer Portal (deep link do app ou URL web)
STRIPE_PORTAL_RETURN_URL=guiaaventureiro://profile

# === LOGGING (Opcional) ===
# Habilitar logs em arquivo (recomendado em produção)
ENABLE_FILE_LOGGING=false

# ========================================
# SEGURANÇA - CHECKLIST DE PRODUÇÃO
# ========================================
# [ ] NODE_ENV=production
# [ ] HTTPS habilitado
# [ ] JWT secrets gerados com crypto.randomBytes(64)
# [ ] FRONTEND_URL com domínios reais (sem wildcards)
# [ ] Credenciais únicas (não reutilizar de dev)
# [ ] MongoDB com autenticação
# [ ] API Keys rotacionadas
# [ ] Arquivo .env no .gitignore
# [ ] Backup automatizado do banco
# [ ] Firewall configurado
# ========================================
